# Application Settings
PROJECT_NAME="Growearn API"
ENVIRONMENT="development"
DEBUG=True

# Render PostgreSQL Database Configuration
# Paste your Render External Database URL below:
DATABASE_URL=postgresql://growearn_user:your_password@dpg-xxxxxxxxxx-a.oregon-postgres.render.com/growearn_db

# Google Gemini AI & Multimodal Embedding Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
GEMINI_INTENT_MODEL=gemini-3.6-flash

